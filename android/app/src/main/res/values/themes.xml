<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose 应用的基础 XML 主题。实际的视觉样式由 ErgouTheme (Compose) 控制。
        这里使用 MaterialComponents 作为启动过渡主题，避免白屏。
    -->
    <style name="Theme.ErgouTreeCrypt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- 不透明窗口底色：enableEdgeToEdge 会把系统栏设为透明，若窗口本身也透明，
             Compose 首帧尚未绘出时会露出底层黑屏。 -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
