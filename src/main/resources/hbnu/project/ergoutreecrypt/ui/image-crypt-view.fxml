<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import org.controlsfx.control.textfield.CustomPasswordField?>
<?import org.controlsfx.control.textfield.CustomTextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="imageRoot" xmlns:fx="http://javafx.com/fxml"
           fx:controller="hbnu.project.ergoutreecrypt.ui.ImageCryptController">
    <VBox styleClass="tab-body">
        <ScrollPane styleClass="content-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
            <HBox alignment="TOP_CENTER">
                <VBox styleClass="content" spacing="16" maxWidth="760" HBox.hgrow="ALWAYS">
                    <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>

                    <HBox styleClass="segmented" alignment="CENTER_LEFT">
                        <ToggleButton fx:id="imageEncryptTab" styleClass="seg-btn" selected="true">
                            <toggleGroup><ToggleGroup fx:id="imageOperationGroup"/></toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="imageDecryptTab" styleClass="seg-btn"
                                      toggleGroup="$imageOperationGroup"/>
                    </HBox>

                    <VBox fx:id="imageDropZone" styleClass="card,drop-zone" spacing="8"
                          alignment="CENTER">
                        <Label fx:id="imageDropIcon" styleClass="drop-icon"/>
                        <Label fx:id="imageDropHint" styleClass="drop-hint"/>
                        <Label fx:id="imageDropSub" styleClass="drop-sub"/>
                    </VBox>

                    <VBox fx:id="imageFileCard" styleClass="card,file-card" spacing="7"
                          managed="false" visible="false">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="file-icon" text="▧"/>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label fx:id="imageFileName" styleClass="file-name"/>
                                <Label fx:id="imageFileMeta" styleClass="file-meta" wrapText="true"/>
                                <Label fx:id="imageProtocolMeta" styleClass="field-hint" wrapText="true"/>
                                <Label fx:id="imageExtensionWarning" styleClass="warning-text"
                                       managed="false" visible="false" wrapText="true"/>
                            </VBox>
                        </HBox>
                        <ImageView fx:id="imageInputPreview" fitWidth="360" fitHeight="220"
                                   preserveRatio="true" smooth="true"/>
                        <Label fx:id="imageInputPreviewCaption" styleClass="field-hint"
                               wrapText="true"/>
                        <HBox alignment="CENTER_RIGHT" spacing="8">
                            <Button fx:id="imageReselectFileBtn" styleClass="btn-secondary"
                                    onAction="#onReselectFile"/>
                            <Button fx:id="imageClearFileBtn" styleClass="btn-ghost"
                                    onAction="#onClearFile"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" spacing="10">
                        <Label fx:id="imageProtectionTitle" styleClass="card-title"/>
                        <HBox styleClass="segmented" alignment="CENTER_LEFT">
                            <ToggleButton fx:id="imagePublicModeBtn" styleClass="seg-btn" selected="true">
                                <toggleGroup><ToggleGroup fx:id="imageProtectionGroup"/></toggleGroup>
                            </ToggleButton>
                            <ToggleButton fx:id="imagePasswordModeBtn" styleClass="seg-btn"
                                          toggleGroup="$imageProtectionGroup"/>
                        </HBox>
                        <VBox fx:id="imagePasswordBox" spacing="8" managed="false" visible="false">
                            <Label fx:id="imagePasswordLabel" styleClass="field-label"/>
                            <StackPane>
                                <CustomPasswordField fx:id="imagePasswordField" styleClass="text-input"/>
                                <CustomTextField fx:id="imagePasswordVisibleField" styleClass="text-input"
                                           managed="false" visible="false"/>
                            </StackPane>
                            <HBox alignment="CENTER_RIGHT">
                                <CheckBox fx:id="imageShowPasswordCheck" styleClass="check"
                                          onAction="#onToggleShowPassword"/>
                            </HBox>
                            <PasswordField fx:id="imageConfirmField" styleClass="text-input"/>
                            <Label fx:id="imageMismatchLabel" styleClass="error-text"
                                   managed="false" visible="false"/>
                            <Label fx:id="imageKdfHint" styleClass="field-hint" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="card" spacing="8">
                        <Label fx:id="imageTransportTitle" styleClass="card-title"/>
                        <CheckBox fx:id="imageErrorCorrectionCheck" styleClass="check"/>
                        <Label fx:id="imageErrorCorrectionHint" styleClass="field-hint"
                               wrapText="true"/>
                        <VBox fx:id="imageRobustnessBox" spacing="6"
                              managed="false" visible="false">
                            <ComboBox fx:id="imageRobustnessCombo" maxWidth="Infinity"/>
                            <Label fx:id="imageRobustnessHint" styleClass="field-hint"
                                   wrapText="true"/>
                        </VBox>
                        <CheckBox fx:id="imageBestEffortCheck" styleClass="check"
                                  managed="false" visible="false"/>
                        <Label fx:id="imageBestEffortHint" styleClass="warning-text"
                               managed="false" visible="false" wrapText="true"/>
                    </VBox>

                    <VBox fx:id="imagePublicWarningCard" styleClass="image-warning-card" spacing="7">
                        <Label fx:id="imagePublicWarning" styleClass="image-warning-text"
                               wrapText="true"/>
                        <Separator/>
                        <Label fx:id="imageSendAsFileHint" styleClass="field-hint" wrapText="true"/>
                    </VBox>

                    <VBox fx:id="imageOutputCard" styleClass="card" spacing="9"
                          managed="false" visible="false">
                        <Label fx:id="imageOutputTitle" styleClass="card-title"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="imageOutputDirectoryField" styleClass="text-input"
                                       HBox.hgrow="ALWAYS"/>
                            <Button fx:id="imageOutputBrowseBtn" styleClass="btn-ghost"
                                    onAction="#onBrowseOutputDirectory"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="imageOutputNameTitle" styleClass="field-label"/>
                            <Label fx:id="imageOutputName" styleClass="file-meta" wrapText="true"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="imageDecryptOptionsCard" styleClass="card" spacing="8"
                          managed="false" visible="false">
                        <Label fx:id="imageDecryptOptionsTitle" styleClass="card-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="2">
                            <CheckBox fx:id="imageDeleteSourceCheck" styleClass="check"/>
                            <Label fx:id="imageDeleteSourceInfo" styleClass="info-icon" text="i"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="imagePreviewCard" styleClass="card,image-preview-card" spacing="9"
                          managed="false" visible="false" alignment="CENTER">
                        <Label fx:id="imagePreviewTitle" styleClass="card-title"/>
                        <ImageView fx:id="imagePreview" fitWidth="360" fitHeight="220"
                                   preserveRatio="true" smooth="true"/>
                        <Label fx:id="imagePreviewCaption" styleClass="field-hint" wrapText="true"/>
                    </VBox>

                    <VBox fx:id="imageResultCard" styleClass="card,image-result-card" spacing="9"
                          managed="false" visible="false">
                        <Label fx:id="imageResultTitle" styleClass="card-title"/>
                        <Label fx:id="imageResultPath" styleClass="file-meta" wrapText="true"/>
                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Button fx:id="imageOpenDirectoryBtn" styleClass="btn-secondary"
                                    onAction="#onOpenResultDirectory"/>
                            <Button fx:id="imageCopyPathBtn" styleClass="btn-ghost"
                                    onAction="#onCopyResultPath"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </ScrollPane>

        <VBox styleClass="footer" spacing="10">
            <padding><Insets top="14" right="24" bottom="18" left="24"/></padding>
            <VBox fx:id="imageProgressBox" spacing="6" managed="false" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="imageStatusLabel" styleClass="status-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="imageProgressInfo" styleClass="status-info"/>
                </HBox>
                <ProgressBar fx:id="imageProgressBar" styleClass="progress" progress="0"
                             maxWidth="Infinity"/>
            </VBox>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="imageCancelBtn" styleClass="btn-secondary"
                        managed="false" visible="false" onAction="#onCancel"/>
                <Button fx:id="imageVerifyBtn" styleClass="btn-secondary"
                        managed="false" visible="false" onAction="#onVerifyIntegrity"/>
                <Button fx:id="imageActionBtn" styleClass="btn-accent" onAction="#onAction"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
